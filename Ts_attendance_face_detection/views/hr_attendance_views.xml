<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Attendance Form: GPS + Snapshot fields ──────────────────────────
         Odoo 18 form view id: hr_attendance.hr_attendance_view_form
    ─────────────────────────────────────────────────────────────────────── -->
    <record id="view_hr_attendance_form_face" model="ir.ui.view">
        <field name="name">hr.attendance.form.face.detection</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <field name="check_out" position="after">
                <field name="attendance_mode" readonly="1"/>
            </field>
            <xpath expr="//form/sheet" position="inside">
                <notebook>
                    <page string="Face &amp; GPS Details" name="face_gps_details">
                        <group string="Check-In Details">
                            <group>
                                <field name="check_in_face_verified" readonly="1"/>
                                <field name="check_in_location_id" readonly="1"/>
                                <field name="check_in_latitude" readonly="1"
                                       invisible="check_in_latitude == 0"/>
                                <field name="check_in_longitude" readonly="1"
                                       invisible="check_in_longitude == 0"/>
                            </group>
                            <group>
                                <field name="check_in_face_image"
                                       widget="image"
                                       options="{'size': [200, 200]}"
                                       readonly="1"
                                       invisible="not check_in_face_image"/>
                            </group>
                        </group>
                        <group string="Check-Out Details">
                            <group>
                                <field name="check_out_face_verified" readonly="1"/>
                                <field name="check_out_location_id" readonly="1"/>
                                <field name="check_out_latitude" readonly="1"
                                       invisible="check_out_latitude == 0"/>
                                <field name="check_out_longitude" readonly="1"
                                       invisible="check_out_longitude == 0"/>
                            </group>
                            <group>
                                <field name="check_out_face_image"
                                       widget="image"
                                       options="{'size': [200, 200]}"
                                       readonly="1"
                                       invisible="not check_out_face_image"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- ── Attendance List: extra columns
         Uses priority=16 + model match instead of inherit_id to avoid
         depending on an XML ID that varies across Odoo 18 builds.
    ─────────────────────────────────────────────────────────────────────── -->
    <record id="view_hr_attendance_tree_face" model="ir.ui.view">
        <field name="name">hr.attendance.tree.face.detection</field>
        <field name="model">hr.attendance</field>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <list string="Attendances" default_order="check_in desc">
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="attendance_mode" optional="show"/>
                <field name="check_in_face_verified" string="Face In" optional="show"/>
                <field name="check_out_face_verified" string="Face Out" optional="show"/>
                <field name="check_in_location_id" string="Location" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Attendance Search: add face-mode filters ────────────────────────
         Also uses model-based approach to avoid brittle XML ID references.
    ─────────────────────────────────────────────────────────────────────── -->
    <record id="view_hr_attendance_filter_face" model="ir.ui.view">
        <field name="name">hr.attendance.filter.face.detection</field>
        <field name="model">hr.attendance</field>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <search string="Attendances">
                <field name="employee_id"/>
                <field name="check_in"/>
                <filter string="Today" name="today"
                        domain="[('check_in','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('check_in','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <separator/>
                <filter string="Face Recognition" name="face_mode"
                        domain="[('attendance_mode', '=', 'face')]"/>
                <filter string="Face Verified (In)" name="face_verified_in"
                        domain="[('check_in_face_verified', '=', True)]"/>
                <filter string="Unverified Check-In" name="face_unverified"
                        domain="[('check_in_face_verified', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Check-In Date" name="group_check_in"
                            context="{'group_by': 'check_in:day'}"/>
                    <filter string="Location" name="group_location"
                            context="{'group_by': 'check_in_location_id'}"/>
                    <filter string="Mode" name="group_mode"
                            context="{'group_by': 'attendance_mode'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
