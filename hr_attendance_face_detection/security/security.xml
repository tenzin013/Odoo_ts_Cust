<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employees can only read their own face encoding status -->
    <record id="rule_face_location_company" model="ir.rule">
        <field name="name">Face Attendance Location: Company Rule</field>
        <field name="model_id" ref="model_face_attendance_location"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
