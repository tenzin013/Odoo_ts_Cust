<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Employee Form: Face Recognition Tab ───────────────────────────── -->
    <record id="view_hr_employee_form_face" model="ir.ui.view">
        <field name="name">hr.employee.form.face.detection</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Face Recognition" name="face_recognition"
                      groups="hr_attendance.group_hr_attendance_manager">
                    <group>
                        <group string="Face Enrollment">
                            <field name="face_recognition_enabled" widget="boolean_toggle"/>
                            <field name="face_image" widget="image"
                                   options="{'size': [200, 200]}"
                                   class="o_field_image"
                                   readonly="1"/>
                            <field name="face_image_filename" invisible="1"/>
                        </group>
                        <group string="Encoding Status">
                            <field name="face_encoding_date" readonly="1"/>
                            <field name="last_face_check" readonly="1"/>
                            <field name="face_encoding" invisible="1"/>
                        </group>
                    </group>

                    <div class="o_face_status_bar mt-3"
                         invisible="not face_encoding">
                        <div class="alert alert-success" role="alert">
                            <i class="fa fa-check-circle me-2"/>
                            Face encoding is active. This employee can use face recognition
                            to check in and out.
                        </div>
                    </div>
                    <div class="alert alert-warning mt-3"
                         invisible="face_encoding">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        No face descriptor yet. Use <strong>Capture from Webcam</strong>
                        below to enrol this employee's face.
                    </div>

                    <div class="mt-3">
                        <widget name="FaceCaptureWidget"/>
                        <button name="action_clear_face_encoding"
                                type="object"
                                string="Clear Encoding"
                                class="btn btn-danger ms-2"
                                invisible="not face_encoding"
                                confirm="Remove the face encoding? The employee will not be able to use face recognition until re-enrolled."/>
                    </div>
                </page>
            </notebook>
        </field>
    </record>

    <!-- ── Employee List view: add face status column ─────────────────────── -->
    <record id="view_hr_employee_tree_face" model="ir.ui.view">
        <field name="name">hr.employee.tree.face.detection</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="department_id" position="after">
                <field name="face_recognition_enabled" string="Face ID"
                       widget="boolean"
                       optional="show"
                       groups="hr_attendance.group_hr_attendance_manager"/>
            </field>
        </field>
    </record>

</odoo>
