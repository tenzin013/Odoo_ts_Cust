<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="kiosk_page" name="Face Attendance Kiosk">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title><t t-esc="company.name"/> — Face Attendance Kiosk</title>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>
                <link rel="stylesheet"
                      t-att-href="'/hr_attendance_face_detection/static/src/css/kiosk.css'"/>
            </head>
            <body class="o_face_kiosk_body">

                <div id="face_kiosk_app"
                     t-att-data-geofencing="'1' if geofencing else '0'">

                    <!-- Loading overlay -->
                    <div id="kiosk_loading_overlay" class="kiosk-loading-overlay">
                        <div class="kiosk-loading-box">
                            <p id="kiosk_loading_msg">Initialising face recognition…</p>
                        </div>
                    </div>

                    <!-- Header -->
                    <header class="kiosk-header">
                        <div class="kiosk-logo">
                            <t t-if="company.logo">
                                <img t-att-src="'data:image/png;base64,' + company.logo.decode()"
                                     alt="Company Logo" height="48"/>
                            </t>
                        </div>
                        <div class="kiosk-company-name">
                            <t t-esc="company.name"/>
                        </div>
                        <div class="kiosk-clock" id="kiosk_clock">--:--:--</div>
                    </header>

                    <!-- Main area -->
                    <main class="kiosk-main">

                        <!-- Camera feed -->
                        <div class="kiosk-camera-wrapper">
                            <video id="kiosk_video" autoplay="autoplay" playsinline="playsinline" muted="muted"></video>
                            <canvas id="kiosk_overlay"></canvas>
                            <div class="kiosk-face-guide">
                                <div class="face-oval"></div>
                            </div>
                            <div id="kiosk_scanning_indicator" class="scanning-bar hidden"></div>
                        </div>

                        <!-- Status panel -->
                        <div class="kiosk-panel">
                            <div id="kiosk_status" class="kiosk-status idle">
                                <i class="fa fa-camera fa-3x mb-3"/>
                                <h2>Position your face in the oval</h2>
                                <p>Face recognition will start automatically</p>
                            </div>

                            <!-- Success card -->
                            <div id="kiosk_success_card" class="kiosk-result-card success hidden">
                                <div class="result-avatar">
                                    <i class="fa fa-user-circle fa-5x"/>
                                </div>
                                <div id="result_action_badge" class="action-badge check-in">CHECK IN</div>
                                <h2 id="result_name">Employee Name</h2>
                                <p id="result_time" class="result-time">--:--</p>
                                <p id="result_location" class="result-location hidden"/>
                                <div class="confidence-bar-wrap">
                                    <span>Confidence</span>
                                    <div class="confidence-bar">
                                        <div id="confidence_fill" class="confidence-fill" style="width:0%"/>
                                    </div>
                                    <span id="confidence_pct">0%</span>
                                </div>
                            </div>

                            <!-- Error card -->
                            <div id="kiosk_error_card" class="kiosk-result-card error hidden">
                                <i class="fa fa-exclamation-triangle fa-4x"/>
                                <h2 id="error_title">Recognition Failed</h2>
                                <p id="error_message">Please try again.</p>
                            </div>

                            <!-- GPS status -->
                            <t t-if="geofencing">
                                <div id="kiosk_gps_status" class="gps-status">
                                    <i class="fa fa-map-marker"/>
                                    <span id="gps_label">Acquiring GPS…</span>
                                </div>
                            </t>

                            <!-- Controls -->
                            <div class="kiosk-controls mt-4">
                                <button id="btn_scan" class="btn-kiosk primary">
                                    <i class="fa fa-id-badge me-2"/>Scan Face
                                </button>
                                <button id="btn_retry" class="btn-kiosk secondary hidden">
                                    <i class="fa fa-refresh me-2"/>Try Again
                                </button>
                            </div>
                        </div>
                    </main>

                    <!-- Footer -->
                    <footer class="kiosk-footer">
                        Powered by Odoo 18 Community — HR Attendance Face Detection
                    </footer>
                </div>

                <!-- face-api.js loaded from CDN before kiosk JS -->
                <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
                <!-- Kiosk JS loaded last -->
                <script t-att-src="'/hr_attendance_face_detection/static/src/js/face_api_kiosk.js?v=20260611'"/>
            </body>
        </html>
    </template>

    <!-- Kiosk launch action -->
    <record id="action_face_attendance_kiosk" model="ir.actions.act_url">
        <field name="name">Face Attendance Kiosk</field>
        <field name="url">/hr_attendance_face/kiosk</field>
        <field name="target">new</field>
    </record>
</odoo>
