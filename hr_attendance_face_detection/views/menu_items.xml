<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo 18 hr_attendance root menu is: hr_attendance.menu_hr_attendance_root
        We create our own Configuration sub-menu parented directly under the root.
        This avoids depending on hr_attendance.menu_hr_attendance_configuration
        which was removed/renamed in Odoo 18.
    -->

    <!-- Our own Configuration parent menu under Attendances root -->
    <menuitem
        id="menu_face_attendance_config_root"
        name="Configuration"
        parent="hr_attendance.menu_hr_attendance_root"
        sequence="90"
        groups="hr_attendance.group_hr_attendance_manager"/>

    <!-- Attendance Locations under our Configuration menu -->
    <menuitem
        id="menu_face_attendance_location"
        name="Attendance Locations"
        parent="menu_face_attendance_config_root"
        action="action_face_attendance_location"
        sequence="10"
        groups="hr_attendance.group_hr_attendance_manager"/>

    <!-- Face Kiosk Mode shortcut under Attendances root -->
    <menuitem
        id="menu_face_attendance_kiosk"
        name="Face Kiosk Mode"
        parent="hr_attendance.menu_hr_attendance_root"
        action="action_face_attendance_kiosk"
        sequence="5"
        groups="hr_attendance.group_hr_attendance_manager"/>

</odoo>
