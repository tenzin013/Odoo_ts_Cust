<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Purchase Order — Form View Inherit                          -->
    <!-- ============================================================ -->
    <record id="view_purchase_order_form_back_date" model="ir.ui.view">
        <field name="name">purchase.order.form.back_date</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet//group[1]" position="before">
                <group string="Back Date Entry"
                       invisible="back_date == False and back_date_applied == False">
                    <field name="back_date" widget="date"/>
                    <field name="back_date_applied" readonly="1"/>
                </group>
            </xpath>

            <xpath expr="//header/button[last()]" position="after">
                <button name="action_apply_back_date"
                        string="Apply Back Date"
                        type="object"
                        class="btn-warning"
                        invisible="back_date == False"
                        confirm="This will update all related dates on this purchase order,
                                  linked receipts and draft vendor bills. Continue?"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Purchase Order — Tree View Inherit                          -->
    <!-- ============================================================ -->
    <record id="view_purchase_order_tree_back_date" model="ir.ui.view">
        <field name="name">purchase.order.tree.back_date</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="back_date" optional="show" string="Back Date"/>
                <field name="back_date_applied" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Server action binding for Purchase Order list               -->
    <!-- ============================================================ -->
    <record id="action_purchase_order_back_date_wizard" model="ir.actions.server">
        <field name="name">Apply Back Date</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = env['back.date.wizard'].with_context(
    active_model='purchase.order',
    active_ids=records.ids,
).action_open_wizard()
        </field>
    </record>

</odoo>
