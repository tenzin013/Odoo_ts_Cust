<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Account Move — Form View Inherit (Invoice)                  -->
    <!-- ============================================================ -->
    <record id="view_account_move_form_back_date" model="ir.ui.view">
        <field name="name">account.move.form.back_date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet//group[1]" position="before">
                <group string="Back Date Entry"
                       invisible="back_date == False and back_date_applied == False">
                    <field name="back_date" widget="date"/>
                    <field name="back_date_applied" readonly="1"/>
                </group>
            </xpath>

            <xpath expr="//header/button[last()]" position="after">
                <button name="action_apply_back_date"
                        string="Apply Back Date"
                        type="object"
                        class="btn-warning"
                        invisible="back_date == False or state == 'posted'"
                        confirm="This will update the invoice date and accounting date.
                                  The entry must be in draft state. Continue?"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Account Move — Tree View Inherit                            -->
    <!-- ============================================================ -->
    <record id="view_account_move_tree_back_date" model="ir.ui.view">
        <field name="name">account.move.tree.back_date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="back_date" optional="show" string="Back Date"/>
                <field name="back_date_applied" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Server action binding for Account Move list                 -->
    <!-- ============================================================ -->
    <record id="action_account_move_back_date_wizard" model="ir.actions.server">
        <field name="name">Apply Back Date</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = env['back.date.wizard'].with_context(
    active_model='account.move',
    active_ids=records.ids,
).action_open_wizard()
        </field>
    </record>

</odoo>
