<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <report
            id="action_report_student_idcard"
            model="school.student"
            string="Student ID Card"
            report_type="qweb-pdf"
            name="school_erp.report_student_idcard"
            file="school_erp.report_student_idcard"
            print_report_name="'Student ID Card - ' + object.name"
            paperformat="paperformat_school_idcard"
        />

        <!-- Custom paper format — CR80 card size (85.6mm × 54mm) -->
        <record id="paperformat_school_idcard" model="report.paperformat">
            <field name="name">School ID Card (CR80)</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_width">85.6</field>
            <field name="page_height">54</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">3</field>
            <field name="margin_bottom">3</field>
            <field name="margin_left">3</field>
            <field name="margin_right">3</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">3</field>
            <field name="dpi">150</field>
        </record>

    </data>
</odoo>
