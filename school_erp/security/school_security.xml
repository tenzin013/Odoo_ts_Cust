<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Module category -->
        <record id="module_school_erp" model="ir.module.category">
            <field name="name">School ERP</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groups -->
        <record id="group_school_user" model="res.groups">
            <field name="name">School / User</field>
            <field name="category_id" ref="module_school_erp"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_school_teacher" model="res.groups">
            <field name="name">School / Teacher</field>
            <field name="category_id" ref="module_school_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_school_user'))]"/>
        </record>

        <record id="group_school_manager" model="res.groups">
            <field name="name">School / Manager</field>
            <field name="category_id" ref="module_school_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_school_teacher'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
