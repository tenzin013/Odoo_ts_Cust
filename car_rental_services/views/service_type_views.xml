<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── LIST VIEW ──────────────────────────────────────── -->
    <record id="view_car_rental_service_type_list" model="ir.ui.view">
        <field name="name">car.rental.service.type.list</field>
        <field name="model">car.rental.service.type</field>
        <field name="arch" type="xml">
            <list string="Service Types" decoration-muted="active == False" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="code" optional="show"/>
                <field name="name" string="Service Type"/>
                <field name="category"/>
                <field name="vehicle_class"/>
                <field name="base_daily_rate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="max_passengers"/>
                <field name="includes_driver" widget="boolean_toggle" optional="show"/>
                <field name="includes_fuel" widget="boolean_toggle" optional="show"/>
                <field name="includes_insurance" widget="boolean_toggle" optional="show"/>
                <field name="vehicle_count" string="Vehicles"/>
                <field name="booking_count" string="Bookings"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── FORM VIEW ──────────────────────────────────────── -->
    <record id="view_car_rental_service_type_form" model="ir.ui.view">
        <field name="name">car.rental.service.type.form</field>
        <field name="model">car.rental.service.type</field>
        <field name="arch" type="xml">
            <form string="Service Type">
                <header>
                    <button name="action_toggle_active"
                            type="object"
                            string="Archive"
                            class="btn-secondary"
                            invisible="not active"/>
                    <button name="action_toggle_active"
                            type="object"
                            string="Unarchive"
                            class="btn-secondary"
                            invisible="active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vehicles"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-car">
                            <field name="vehicle_count" widget="statinfo" string="Vehicles"/>
                        </button>
                        <button name="action_view_bookings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar-check-o">
                            <field name="booking_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Economy, Luxury, SUV..."/>
                        </h1>
                        <div class="o_row">
                            <field name="code" placeholder="Code (e.g. ECO)"/>
                            <field name="active" widget="boolean_toggle"/>
                            <label for="active" string="Active"/>
                        </div>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="category"/>
                            <field name="vehicle_class"/>
                            <field name="max_passengers"/>
                            <field name="min_rental_days"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="Pricing">
                            <field name="currency_id" invisible="1"/>
                            <field name="base_daily_rate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="weekend_rate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="weekly_rate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="monthly_rate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="security_deposit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>

                    <group string="Kilometre Policy">
                        <group>
                            <field name="free_km_per_day"/>
                            <field name="extra_km_charge" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>

                    <group string="Included Features">
                        <group>
                            <field name="includes_driver"/>
                            <field name="includes_fuel"/>
                            <field name="includes_insurance"/>
                        </group>
                        <group>
                            <field name="includes_gps"/>
                            <field name="includes_child_seat"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" widget="html" placeholder="Describe this service type for customers..."/>
                        </page>
                        <page string="Vehicles" name="vehicles">
                            <field name="vehicle_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="license_plate"/>
                                    <field name="brand"/>
                                    <field name="model_year"/>
                                    <field name="fuel_type"/>
                                    <field name="transmission"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state=='available'"
                                           decoration-warning="state=='reserved'"
                                           decoration-danger="state=='maintenance'"
                                           decoration-info="state=='rented'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="Internal notes about this service type..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── KANBAN VIEW ────────────────────────────────────── -->
    <record id="view_car_rental_service_type_kanban" model="ir.ui.view">
        <field name="name">car.rental.service.type.kanban</field>
        <field name="model">car.rental.service.type</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="base_daily_rate"/>
                <field name="currency_id"/>
                <field name="vehicle_count"/>
                <field name="booking_count"/>
                <field name="color"/>
                <field name="includes_driver"/>
                <field name="includes_insurance"/>
                <field name="includes_gps"/>
                <field name="active"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="image" widget="image" class="o_image_64_cover" alt="Service Image"/>
                        </aside>
                        <main>
                            <div class="d-flex">
                                <field name="color" widget="color_picker" readonly="1"/>
                                <strong class="o_kanban_record_title ms-1">
                                    <field name="name"/>
                                </strong>
                                <small class="ms-1 text-muted" t-if="record.code.value">
                                    [<field name="code"/>]
                                </small>
                            </div>
                            <div class="text-muted small">
                                <field name="category"/>
                            </div>
                            <div class="mt-1">
                                <strong><field name="base_daily_rate" widget="monetary" options="{'currency_field': 'currency_id'}"/></strong>
                                <span class="text-muted"> / day</span>
                            </div>
                            <div class="mt-1 d-flex gap-2">
                                <span class="badge bg-primary" t-if="record.vehicle_count.value">
                                    <i class="fa fa-car"/> <field name="vehicle_count"/> Vehicles
                                </span>
                                <span class="badge bg-success" t-if="record.includes_driver.value">
                                    <i class="fa fa-user"/> Driver
                                </span>
                                <span class="badge bg-info" t-if="record.includes_gps.value">
                                    <i class="fa fa-map-marker"/> GPS
                                </span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── SEARCH VIEW ────────────────────────────────────── -->
    <record id="view_car_rental_service_type_search" model="ir.ui.view">
        <field name="name">car.rental.service.type.search</field>
        <field name="model">car.rental.service.type</field>
        <field name="arch" type="xml">
            <search string="Search Service Types">
                <field name="name" string="Service Type"/>
                <field name="code"/>
                <field name="category"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="economy" string="Economy" domain="[('category','=','economy')]"/>
                <filter name="standard" string="Standard" domain="[('category','=','standard')]"/>
                <filter name="luxury" string="Luxury" domain="[('category','in',['premium','luxury'])]"/>
                <filter name="suv" string="SUV" domain="[('category','=','suv')]"/>
                <filter name="chauffeur" string="Chauffeur" domain="[('category','=','chauffeur')]"/>
                <filter name="electric" string="Electric/Hybrid" domain="[('category','=','electric')]"/>
                <separator/>
                <filter name="with_driver" string="Includes Driver" domain="[('includes_driver','=',True)]"/>
                <filter name="with_fuel" string="Includes Fuel" domain="[('includes_fuel','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_vehicle_class" string="Vehicle Class" context="{'group_by': 'vehicle_class'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── ACTION ─────────────────────────────────────────── -->
    <record id="action_car_rental_service_type" model="ir.actions.act_window">
        <field name="name">Service Types</field>
        <field name="res_model">car.rental.service.type</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_car_rental_service_type_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Service Type!
            </p>
            <p>
                Define rental service categories like Economy, Standard, Luxury, SUV, Chauffeur Driven, and more.
                Each service type has its own pricing, inclusions, and vehicle class.
            </p>
        </field>
    </record>

</odoo>
